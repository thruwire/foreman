# Create an API key at https://console.typesafe.ai/.
TYPESAFE_API_KEY=

# Optional overrides supported by the official SDK.
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# OpenRouter alternative: see docs/openrouter.md.
# Set TYPESAFE_API_KEY above to your OpenRouter key and uncomment this base URL.
# TYPESAFE_BASE_URL=https://openrouter.ai/api

# Backends: codex (default), opencode, hermes, or deepagents.
# FOREMAN_WORKER_BACKEND=codex

# Deep Agents Code requires a separately installed dcode CLI (deepagents-code >=0.1.83).
# FOREMAN_DEEPAGENTS_EXECUTABLE=dcode
# FOREMAN_DEEPAGENTS_MODEL=openai:your-model
# FOREMAN_DEEPAGENTS_MAX_TURNS=200
# FOREMAN_DEEPAGENTS_SHELL_ALLOW_LIST=recommended

# Live steering uses Codex App Server by default. Use `exec` as a non-steerable fallback.
# FOREMAN_CODEX_BACKEND=app-server
# FOREMAN_STEERING_ENABLED=true
# FOREMAN_MAX_STEERS_PER_WORKER=1
# FOREMAN_STEERING_GRACE_SECONDS=30
