# Create an API key at https://console.typesafe.ai/.
TYPESAFE_API_KEY=

# Optional overrides supported by the official SDK.
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Live steering uses Codex App Server by default. Use `exec` as a non-steerable fallback.
# FOREMAN_CODEX_BACKEND=app-server
# FOREMAN_STEERING_ENABLED=true
# FOREMAN_MAX_STEERS_PER_WORKER=1
# FOREMAN_STEERING_GRACE_SECONDS=30
